# ---------- Core ----------
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"          # SQLite for local dev. For production use e.g.
                                       # postgresql://user:password@host:5432/delicious_sheri

# ---------- Auth ----------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_GATE_PASSPHRASE=replace_with_a_secret_passphrase   # first-layer gate before login form even loads

# Seed admin (used once by prisma/seed.js to create the first admin account)
SEED_ADMIN_USERNAME=osarmkhan
SEED_ADMIN_PASSWORD=ChangeThisImmediately123!

# ---------- Frontend (3 separately deployed apps) ----------
CUSTOMER_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
RIDER_URL=http://localhost:5175

# ---------- Geo-targeted shipping ----------
# Your bakery's home city — orders shipping within this city get a local rider;
# anywhere else in Pakistan (any city, town, or rural/dehat address) automatically
# switches to third-party courier shipping with weight-based cargo fees.
STORE_CITY=Karachi

# ---------- Card Gateway (Visa / Debit) ----------
# Recommended: use a hosted-checkout processor (e.g. Stripe, PayFast, HBL PayPlus) so you
# never touch raw card numbers on your own server (PCI-DSS scope stays with the processor).
CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_SECRET_KEY=
CARD_GATEWAY_WEBHOOK_SECRET=

# ---------- JazzCash ----------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:5173/checkout/callback
JAZZCASH_ENV=sandbox   # sandbox | production

# ---------- EasyPaisa ----------
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_ENV=sandbox

# ---------- SMS (rider OTP + delivery code) ----------
# Default (unset or "simulator"): OTPs/codes are logged to the backend console
# instead of actually sent — fine for local dev/testing, not for production.
# Set to "twilio" once you have a real Twilio account and fill in the 3 vars
# below (see backend/src/services/sms/smsService.js for exactly where they're used).
SMS_PROVIDER=simulator
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SADAPAY_API_KEY=
SADAPAY_MERCHANT_ID=
SADAPAY_ENV=sandbox

# ---------- Stripe Connect (automated split payments for dropshipped items) ----------
# Needed for real cost/margin payment splitting (see services/payments/stripeConnect.js).
# Without these, vendor orders still work — split settlement just falls back to
# "manual" status for the admin to reconcile via the Vendors page instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
